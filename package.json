  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.65.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6"
  }
}
