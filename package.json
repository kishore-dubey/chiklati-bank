{
  "name": "chiklati-bank",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 || >=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
