# Copy to apps/api/.env and apps/web/.env.local
# Each app only reads the vars it needs; unused ones are harmless.

# --- Shared / apps/api ---
# Ports 5433/6380 (not 5432/6379) to avoid colliding with other local docker stacks
DATABASE_URL="postgresql://chiklati:chiklati@localhost:5433/chiklati_bank?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=4000
LOG_LEVEL=info

# --- apps/web (Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-only-secret-change-me-in-every-other-env"

# --- apps/api: Unit BaaS (sandbox) ---
UNIT_API_BASE_URL="https://api.s.unit.sh"
UNIT_API_TOKEN=""      # set in apps/api/.env only -- sandbox org token, never commit
UNIT_WEBHOOK_SECRET=""  # from Unit dashboard after registering your ngrok URL
UNIT_DEFAULT_DEPOSIT_PRODUCT="checking"  # confirmed against this org's sandbox in Phase 2

# --- apps/web <-> apps/api service-to-service auth ---
INTERNAL_API_SECRET="dev-only-secret-change-me-in-every-other-env"
API_URL="http://localhost:4000"
