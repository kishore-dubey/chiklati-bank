generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications  Application[]
  customers     Customer[]
  accounts      Account[]
  counterparties Counterparty[]
  payments      Payment[]
  cards         Card[]

  @@map("users")
}

enum ApplicationType {
  Individual
  Business
}

enum ApplicationStatus {
  AwaitingDocuments
  PendingReview
  Approved
  Denied
  Canceled
}

enum CustomerType {
  Individual
  Business
}

enum CustomerStatus {
  Active
  Archived
}

enum AccountStatus {
  Open
  Frozen
  Closed
}

enum TransactionDirection {
  Credit
  Debit
}

enum PaymentRail {
  Book
  Ach
  Wire
}

enum PaymentDirection {
  Credit
  Debit
}

enum PaymentStatus {
  Pending
  PendingReview
  Clearing
  Sent
  Rejected
  Canceled
}

enum CounterpartyAccountType {
  Checking
  Savings
  Loan
}

enum CounterpartyType {
  Business
  Person
  Unknown
}

enum CounterpartyPermissions {
  CreditOnly
  DebitOnly
  CreditAndDebit
}

enum WebhookEventStatus {
  Pending
  Processed
  Failed
  Skipped
}

enum CardType {
  IndividualVirtual
  BusinessVirtual
}

enum CardStatus {
  Active
  Inactive
  Frozen
  ClosedByCustomer
  Stolen
  Lost
  SuspectedFraud
}

model Application {
  id                String            @id @default(uuid())
  unitApplicationId String            @unique
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  type              ApplicationType
  status            ApplicationStatus @default(AwaitingDocuments)
  applicantSnapshot Json
  lastEventAt       DateTime?
  customer          Customer?
  webhookEvents     WebhookEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@map("applications")
}

model Customer {
  id             String         @id @default(uuid())
  unitCustomerId String         @unique
  type           CustomerType
  status         CustomerStatus @default(Active)
  applicationId  String         @unique
  application    Application    @relation(fields: [applicationId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  lastEventAt    DateTime?
  accounts       Account[]
  counterparties Counterparty[]
  cards          Card[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@map("customers")
}

model Account {
  id             String         @id @default(uuid())
  unitAccountId  String         @unique
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  depositProduct String
  status         AccountStatus  @default(Open)
  currency       String         @default("USD")
  balance        BigInt         @default(0)
  hold           BigInt         @default(0)
  available      BigInt         @default(0)
  routingNumber  String
  accountNumber  String
  tags           Json?
  lastEventAt    DateTime?
  transactions   Transaction[]
  payments       Payment[]
  cards          Card[]
  webhookEvents  WebhookEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([customerId])
  @@map("accounts")
}

model Transaction {
  id                String               @id @default(uuid())
  unitTransactionId String               @unique
  accountId         String
  account           Account              @relation(fields: [accountId], references: [id])
  paymentId         String?
  payment           Payment?             @relation(fields: [paymentId], references: [id])
  cardId            String?
  card              Card?                @relation(fields: [cardId], references: [id])
  type              String
  direction         TransactionDirection
  amount            BigInt
  balance           BigInt
  summary           String
  tags              Json?
  unitCreatedAt     DateTime
  lastEventAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([accountId, unitCreatedAt])
  @@map("transactions")
}

model Counterparty {
  id                 String                    @id @default(uuid())
  unitCounterpartyId String                    @unique
  customerId         String
  customer           Customer                  @relation(fields: [customerId], references: [id])
  userId             String
  user               User                      @relation(fields: [userId], references: [id])
  name               String
  routingNumber      String
  accountNumber      String
  accountType        CounterpartyAccountType
  type               CounterpartyType
  permissions        CounterpartyPermissions?
  tags               Json?
  payments           Payment[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([userId])
  @@index([customerId])
  @@map("counterparties")
}

model Payment {
  id                   String            @id @default(uuid())
  unitPaymentId        String            @unique
  rail                 PaymentRail
  accountId            String
  account              Account           @relation(fields: [accountId], references: [id])
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  direction            PaymentDirection  @default(Credit)
  amount               BigInt
  status               PaymentStatus
  description          String
  counterpartyId       String?
  counterparty         Counterparty?     @relation(fields: [counterpartyId], references: [id])
  counterpartySnapshot Json
  tags                 Json?
  lastEventAt          DateTime?
  transactions         Transaction[]
  webhookEvents        WebhookEvent[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([counterpartyId])
  @@map("payments")
}

model Card {
  id             String         @id @default(uuid())
  unitCardId     String         @unique
  accountId      String
  account        Account        @relation(fields: [accountId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  type           CardType
  status         CardStatus     @default(Active)
  last4Digits    String
  expirationDate String
  tags           Json?
  lastEventAt    DateTime?
  transactions   Transaction[]
  webhookEvents  WebhookEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([customerId])
  @@map("cards")
}

model WebhookEvent {
  id            String             @id @default(uuid())
  unitEventId   String             @unique
  type          String
  payload       Json
  applicationId String?
  application   Application?       @relation(fields: [applicationId], references: [id])
  accountId     String?
  account       Account?           @relation(fields: [accountId], references: [id])
  paymentId     String?
  payment       Payment?           @relation(fields: [paymentId], references: [id])
  cardId        String?
  card          Card?              @relation(fields: [cardId], references: [id])
  status        WebhookEventStatus @default(Pending)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  error         String?
  createdAt     DateTime           @default(now())

  @@index([status])
  @@map("webhook_events")
}
