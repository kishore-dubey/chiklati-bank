{
  "name": "@chiklati/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "start:worker": "node --env-file=.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chiklati/db": "workspace:*",
    "@chiklati/shared": "workspace:*",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "bullmq": "5.81.2",
    "jose": "6.2.4",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@chiklati/config": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "tsx": "4.23.1",
    "eslint": "9.39.5",
    "vitest": "4.1.10",
    "supertest": "7.2.2",
    "pino-pretty": "13.1.3",
    "@types/supertest": "6.0.3"
  }
}
